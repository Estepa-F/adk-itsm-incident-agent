# Copy to .env at the repo root and fill in. Never commit the real .env.

# Google Cloud (ADC provides the identity; no API key)
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=eu
MODEL_LOCATION=eu

# ServiceNow (dedicated service account, roles itil + snc_basic_auth_api_access)
SERVICENOW_INSTANCE_URL=https://devXXXXXX.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Deployment (filled after python -m deploy.deploy)
AGENT_RUNTIME_LOCATION=europe-west1
STAGING_BUCKET=gs://your-gcp-project-id-staging-ew1
AGENT_RESOURCE_NAME=
